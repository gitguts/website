---
import { getLang, copy, homeUrl } from '../i18n/ui';

const lang = getLang(Astro);
const t = copy[lang];
const home = homeUrl[lang];
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div class="foot__about">
        <a class="brand" href={`${home}#top`}
          ><span class="brand__dot"></span>git<b>guts</b></a
        >
        <p>{t.footer.about}</p>
      </div>
      <div>
        <h4>{t.footer.colSite}</h4>
        <ul>
          <li><a href={`${home}#o-nas`}>{t.nav.about}</a></li>
          <li><a href={`${home}#warsztaty`}>{t.nav.workshops}</a></li>
          <li><a href={`${home}#wydarzenia`}>{t.nav.events}</a></li>
          <li><a href={`${home}#kontrybutorzy`}>{t.nav.contributors}</a></li>
          <li><a href={`${home}#dolacz`}>{t.footer.join}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t.footer.colDocs}</h4>
        <ul>
          <li><a href={`${home}privacy-policy/`}>{t.footer.privacy}</a></li>
          <li><a href={`${home}terms-of-service/`}>{t.footer.terms}</a></li>
          <li><a href={`${home}cookies/`}>{t.footer.cookies}</a></li>
        </ul>
      </div>
    </div>
    <div class="foot__bottom">
      <span>© {year} Git Guts · {t.footer.rights}</span>
      <span class="mono">made with ❤ &amp; git commit</span>
    </div>
  </div>
</footer>
