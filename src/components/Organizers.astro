---
import { getLang, copy } from "../i18n/ui";

const lang = getLang(Astro);
const t = copy[lang].contributors;
---

<section class="commit" id="kontrybutorzy">
  <div class="commit__rail"><span class="commit__node"></span></div>
  <div class="commit__body">
    <span class="eyebrow mono">git blame · <span class="sha">{t.eyebrowSha}</span></span>
    <h2 class="title">{t.title}</h2>
    <p class="lead">{t.lead}</p>
    <div class="pcard">
      <h3><span class="glyph">ŁR</span>{t.name}</h3>
      <p>{t.bio}</p>
      <div class="plinks">
        <a href="https://www.dragonia.org.pl" target="_blank" rel="noopener">dragonia.org.pl</a>
      </div>
    </div>
  </div>
</section>
