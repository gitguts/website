---
import { getLang, copy } from '../i18n/ui';

const lang = getLang(Astro);
const t = copy[lang].newsletter;
---

<section class="commit commit--accent commit--tail" id="dolacz">
  <div class="commit__rail"><span class="commit__node"></span></div>
  <div class="commit__body">
    <div class="signup">
      <span class="eyebrow mono">git remote add origin</span>
      <h2>{t.h2}</h2>
      <p>{t.p}</p>
      <form
        class="form"
        id="newsletter-form"
        action="https://assets.mailerlite.com/jsonp/2468961/forms/191188705177764961/subscribe"
        method="post"
        target="ml-sink"
      >
        <input
          type="email"
          id="email"
          name="fields[email]"
          placeholder={t.placeholder}
          aria-label={t.emailLabel}
          required
        />
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <button class="btn btn--primary" type="submit">
          {t.submit}
          <span class="mono">↵</span>
        </button>
      </form>
      <!-- cross-origin POST target: keeps the page from navigating to MailerLite -->
      <iframe
        name="ml-sink"
        title="MailerLite"
        aria-hidden="true"
        tabindex="-1"
        style="display:none"></iframe>
      <p class="form__ok mono" id="ok">{t.success}</p>
    </div>
  </div>
</section>
