---
---

<section class="commit commit--head in" id="hero">
  <div class="commit__rail"><span class="commit__node"></span></div>
  <div class="commit__body hero__body hero">
    <span class="eyebrow mono">HEAD → main <span class="sha">· a1b2c3d</span></span>
    <h1>Poznaj gita <em>od podszewki</em>.</h1>
    <p class="lead">
      Bezpłatne warsztaty, które uczą nie tylko jak <span class="mono">commit</span
      >ować, ale też jak git działa w środku — blob po blobie, drzewo po drzewie.
    </p>
    <div class="cta-row">
      <a class="btn btn--primary" href="#dolacz"
        >Zapisz się na warsztaty <span class="mono">→</span></a
      >
      <a class="btn btn--ghost" href="#warsztaty"
        >Zobacz program <span class="mono">git log</span></a
      >
    </div>

    <div class="graph" id="graph">
      <div class="graph__bar">
        <i></i><i></i><i></i><span class="mono">git log --graph --oneline</span>
      </div>
      <svg
        viewBox="0 0 720 374"
        role="img"
        aria-label="Graf gita: historia commitów oraz obiekty w katalogu .git"
      >
        <!-- ===== BAND 1: commit history ===== -->
        <path class="gpath g1" d="M70 60 L70 230" fill="none" stroke="#663399" stroke-width="2.5"></path>
        <path class="gpath g3" d="M70 130 C104 145 150 150 150 182" fill="none" stroke="#F0502E" stroke-width="2.5"></path>
        <path class="gpath g4" d="M150 182 C150 214 104 216 70 230" fill="none" stroke="#F0502E" stroke-width="2.5"></path>

        <g class="gnode g1"><circle cx="70" cy="60" r="10" fill="#fff" stroke="#663399" stroke-width="3"></circle></g>
        <g class="gnode g2"><circle cx="70" cy="130" r="10" fill="#fff" stroke="#663399" stroke-width="3"></circle></g>
        <g class="gnode g3"><circle cx="150" cy="182" r="8.5" fill="#fff" stroke="#F0502E" stroke-width="3"></circle></g>
        <g class="gnode g4"><circle cx="70" cy="230" r="10" fill="#663399"></circle></g>

        <text class="gtext g1 mono" x="92" y="65" font-size="14" fill="#1C1530">feat: od podstaw</text>
        <text class="gtext g2 mono" x="92" y="135" font-size="14" fill="#1C1530">feat: wnętrzności .git</text>
        <text class="gtext g3 mono" x="170" y="187" font-size="12.5" fill="#F0502E">branch</text>
        <text class="gtext g4 mono" x="92" y="235" font-size="14" fill="#1C1530">merge: społeczność dev</text>

        <line class="gtext g4" x1="40" y1="270" x2="680" y2="270" stroke="#E6DEF4" stroke-width="1.5" stroke-dasharray="4 5"></line>

        <!-- ===== BAND 2: anatomy of .git ===== -->
        <text class="gtext g4 mono" x="40" y="300" font-size="12.5" fill="#6A6280">// co siedzi w .git</text>

        <path class="gpath g5" d="M76 330 L210 330" fill="none" stroke="#CDBEE8" stroke-width="2"></path>
        <path class="gpath g6" d="M242 330 L350 312" fill="none" stroke="#CDBEE8" stroke-width="2"></path>
        <path class="gpath g6" d="M242 330 L350 348" fill="none" stroke="#CDBEE8" stroke-width="2"></path>

        <g class="gnode g5"><rect x="50" y="317" width="26" height="26" rx="6" fill="#F2ECFB" stroke="#663399" stroke-width="2.5"></rect></g>
        <g class="gnode g5"><rect x="216" y="317" width="26" height="26" rx="6" fill="#fff" stroke="#663399" stroke-width="2.5"></rect></g>
        <g class="gnode g6"><circle cx="362" cy="312" r="11" fill="#fff" stroke="#6A6280" stroke-width="2.5"></circle></g>
        <g class="gnode g6"><circle cx="362" cy="348" r="11" fill="#fff" stroke="#6A6280" stroke-width="2.5"></circle></g>

        <text class="gtext g5 mono" x="63" y="362" font-size="13" fill="#663399" text-anchor="middle">commit</text>
        <text class="gtext g5 mono" x="229" y="362" font-size="13" fill="#663399" text-anchor="middle">tree</text>
        <text class="gtext g6 mono" x="382" y="316" font-size="13" fill="#6A6280">blob</text>
        <text class="gtext g6 mono" x="382" y="352" font-size="13" fill="#6A6280">blob</text>
      </svg>
    </div>
  </div>
</section>
